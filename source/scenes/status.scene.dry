@government

[? if president == "Wilhelm II" : <h1><span style="color: #000000">Imperial </span>Government</h1>?]
<hr>

[? if president == "Wilhelm II" : <div><img src="img/portraits/Wilhelm_II_portrait.jpg" alt="Wilhelm II" style="width: 50%; display: block; margin-top: 5px; margin: auto; margin-bottom: 5px; border: 5px solid var(--card-border-color);"></div> ?]
<div style="text-align: center;"><strong>[+ president +]</strong> (<span style="color: var(--president_party_color)"><strong>[+ president_party +]</strong></span>)</div>
[? if president == "Wilhelm II" : <div style="text-align: center; color: var(--unavailable-color); font-size: 0.8em;"><em>Emperor</em></div>?]
[? if nov_revolution = 1 : <div style="text-align: center; color: var(--unavailable-color); font-size: 0.8em;"><em>President</em></div>?]

= Cabinet

[? if chancellor == "Hollweg" : <div><img src="img/portraits/Bethmann_Hollweg_portrait.jpg" alt="Theobald von Bethmann Hollweg" style="width: 50%; display: block; margin-top: 5px; margin: auto; margin-bottom: 5px; border: 5px solid var(--card-border-color);"></div> ?]
[? if chancellor == "Michaelis" : <div><img src="img/portraits/Georg_Michaelis.jpg" alt="Georg Michaelis" style="width: 50%; display: block; margin-top: 5px; margin: auto; margin-bottom: 5px; border: 5px solid var(--card-border-color);"></div> ?]
<div style="text-align: center;"><strong>[+ chancellor +]</strong> (<span style="color: var(--chancellor_party_color)"><strong>[+ chancellor_party +]</span></strong>)</div>
<div style="text-align: center; color: var(--unavailable-color); font-size: 0.8em;"><em>Chancellor</em></div>

<div style="text-align: center;">Vice-chancellor: <br>[+ vice_chancellor +] (<span style="color: var(--vice_chancellor_party_color)"><strong>[+ vice_chancellor_party +]</span></strong>)</div>

[? if month = 2 and year = 1919 : <div style="text-align: center;">Minister of Labor: <br>[+ labor_minister +] (<span style="color: var(--labor_minister_party_color)"><strong>[+ labor_minister_party +]</strong></span>)</div> ?]

<div style="text-align: center;">Minister of the Interior: <br>[+ interior_minister +] (<span style="color: var(--interior_minister_party_color)"><strong>[+ interior_minister_party +]</strong></span>)</div>

<div style="text-align: center;">Minister of Finance: <br>[+ finance_minister +] (<span style="color: var(--finance_minister_party_color)"><strong>[+ finance_minister_party +]</strong></span>)</div>

[? if month = 10 and year = 1919 : <div style="text-align: center;">Minister of Economic: <br>[+ economic_minister +] (<span style="color: var(--economic_minister_party_color)"><strong>[+ economic_minister_party +]</strong></span>)</div> ?]

<div style="text-align: center;">Minister of Justice: <br>[+ justice_minister +] (<span style="color: var(--justice_minister_party_color)"><strong>[+ justice_minister_party +]</strong></span>)</div>

<div style="text-align: center;">Minister of Foreign Affairs: <br>[+ foreign_minister +] (<span style="color: var(--foreign_minister_party_color)"><strong>[+ foreign_minister_party +]</strong></span>)</div>

[? if nov_revolution = 0 : <div style="text-align: center;">Minister of War: <br>[+ reichswehr_minister +] (<span style="color: var(--reichswehr_minister_party_color)"><strong>[+ reichswehr_minister_party +]</strong></span>)</div> ?]
[? if nov_revolution = 1 : <div style="text-align: center;">Minister of Reichswehr: <br>[+ reichswehr_minister +] (<span style="color: var(--reichswehr_minister_party_color)"><strong>[+ reichswehr_minister_party +]</strong></span>)</div> ?]

<div style="text-align: center;">Minister of Agriculture: <br>[+ agriculture_minister +] (<span style="color: var(--agriculture_minister_party_color)"><strong>[+ agriculture_minister_party +]</strong></span>)</div>

@parliament
on-arrival: {!

Q.spd_seats = Math.round(Q.spd_r*Q.reichstag_seats);
let spdPer = (Q.spd_seats / (Q.reichstag_seats * 100)) * 100
Q.spd_per = spdPer.toFixed(1)

Q.uspd_seats = Math.round(Q.uspd_r*Q.reichstag_seats);
let uspdPer = (Q.uspd_seats / (Q.reichstag_seats * 100)) * 100
Q.uspd_per = uspdPer.toFixed(1)

Q.sapd_seats = Math.round(Q.sapd_r*Q.reichstag_seats);
let sapdPer = (Q.sapd_seats / (Q.reichstag_seats * 100)) * 100
Q.sapd_per = sapdPer.toFixed(1)

Q.kpd_seats = Math.round(Q.kpd_r*Q.reichstag_seats);
let kpdPer = (Q.kpd_seats / (Q.reichstag_seats * 100)) * 100
Q.kpd_per = kpdPer.toFixed(1)

Q.z_seats = Math.round(Q.z_r*Q.reichstag_seats);
let zPer = (Q.z_seats / (Q.reichstag_seats * 100)) * 100
Q.z_per = zPer.toFixed(1)

Q.bvp_seats = Math.round(Q.bvp_r*Q.reichstag_seats);
let bvpPer = (Q.bvp_seats / (Q.reichstag_seats * 100)) * 100
Q.bvp_per = bvpPer.toFixed(1)

Q.ddp_seats = Math.round(Q.ddp_r*Q.reichstag_seats);
let ddpPer = (Q.ddp_seats / (Q.reichstag_seats * 100)) * 100
Q.ddp_per = ddpPer.toFixed(1)

Q.other_seats = Math.round(Q.other_r*Q.reichstag_seats);
let otherPer = (Q.other_seats / (Q.reichstag_seats * 100)) * 100
Q.other_per = otherPer.toFixed(1)

Q.dvp_seats = Math.round(Q.dvp_r*Q.reichstag_seats);
let dvpPer = (Q.dvp_seats / (Q.reichstag_seats * 100)) * 100
Q.dvp_per = dvpPer.toFixed(1)

Q.dnvp_seats = Math.round(Q.dnvp_r*Q.reichstag_seats);
let dnvpPer = (Q.dnvp_seats / (Q.reichstag_seats * 100)) * 100
Q.dnvp_per = dnvpPer.toFixed(1)

Q.nsdap_seats = Math.round(Q.nsdap_r*Q.reichstag_seats);
let nsdapPer = (Q.nsdap_seats / (Q.reichstag_seats * 100)) * 100
Q.nsdap_per = nsdapPer.toFixed(1)

if (Q.pp_dissolved == 0) {Q.pp_seats = Math.round(4.5*Q.reichstag_seats)}
if (Q.pp_dissolved == 1) {Q.pp_seats = 0}

if (Q.dhp_dissolved == 0) {Q.dhp_seats = Math.round(1.25*Q.reichstag_seats)}
if (Q.dhp_dissolved == 1) {Q.dhp_seats = 0}

if (Q.elp_dissolved == 0) {Q.elp_seats = Math.round(2.25*Q.reichstag_seats)}
if (Q.elp_dissolved == 1) {Q.elp_seats = 0}

if (Q.bb_dissolved == 0) {Q.bb_seats = Math.round(1.75*Q.reichstag_seats)}
if (Q.bb_dissolved == 1) {Q.bb_seats = 0}

if (Q.drp_dissolved == 0) {Q.drp_seats = Math.round(3.5*Q.reichstag_seats)}
if (Q.drp_dissolved == 1) {Q.drp_seats = 0}

if (Q.ansem_dissolved == 0) {Q.ansem_seats = Math.round(2.5*Q.reichstag_seats)}
if (Q.ansem_dissolved == 1) {Q.ansem_seats = 0}

Q.total_seats = (Q.spd_seats + Q.uspd_seats + Q.sapd_seats + Q.kpd_seats + Q.z_seats + Q.bvp_seats + Q.ddp_seats + Q.other_seats + Q.dvp_seats + Q.dnvp_seats + Q.nsdap_seats + Q.pp_seats + Q.dhp_seats + Q.elp_seats + Q.bb_seats + Q.drp_seats + Q.ansem_seats) 

!}
on-display: {!
/* TODO: potentially move to a js script for ease of access and cleaner code */
const data_st = []

function _addStatusParty(id, legend, seats) {
    if (seats && seats > 0) data_st.push({id: id, legend: legend, name: legend, seats});
}

if (Q.kpd_formed && Q.kpd_r) {_addStatusParty('kpd', "KPD", Q.kpd_seats)}
if (Q.uspd_formed) {_addStatusParty('uspd', "USPD", Q.uspd_seats)}
if (Q.spd_r) {_addStatusParty('spd', "SPD", Q.spd_seats)}
if (Q.sapd_r && Q.sapd_formed) {_addStatusParty('sapd', "SAPD", Q.sapd_seats)} /* Before or after SPD? Dont feel like googling rn */

if (Q.other_r) {_addStatusParty('other', "SPD", Q.other_seats)}

if (Q.pp_dissolved == 0) {_addStatusParty('pp', "PP", Q.pp_seats)}
if (Q.dhp_dissolved == 0) {_addStatusParty('dhp', "DHP", Q.dhp_seats)}
if (Q.elp_dissolved == 0) {_addStatusParty('elp', "ELP", Q.elp_seats)}
if (Q.bb_dissolved == 0) {_addStatusParty('bb', "BB", Q.bb_seats)}

if (Q.ddp_r && Q.ddp_name_change == 0) {_addStatusParty('fvp', Q.ddp_name, Q.ddp_seats)}
if (Q.ddp_r && Q.ddp_name_change == 1) {_addStatusParty('ddp', Q.ddp_name, Q.ddp_seats)}

if (Q.z_r) {_addStatusParty('z', "Z", Q.z_seats)}
if (Q.bvp_r && Q.bvp_formed) {_addStatusParty('bvp', "BVP", Q.bvp_seats)}

if (Q.dvp_r && Q.dvp_name_change == 0) {_addStatusParty('nlp', Q.dvp_name, Q.dvp_seats)}
if (Q.dvp_r && Q.dvp_name_change == 1) {_addStatusParty('dvp', Q.ddp_name, Q.ddp_seats)}

if (Q.drp_dissolved == 0) {_addStatusParty('drp', "DRP", Q.drp_seats)}

if (Q.dnvp_r && Q.dnvp_name_change == 0) {_addStatusParty('dkp', Q.dnvp_name, Q.dnvp_seats)}
if (Q.dnvp_r && Q.dnvp_name_change == 1) {_addStatusParty('dnvp', Q.dnvp_name, Q.dnvp_seats)}

if (Q.ansem_dissolved == 0) {_addStatusParty('dsp', "DvP", Q.ansem_seats)}
if (Q.nsdap_formed && Q.nsdap_banned == 0 && Q.nsdap_r) {_addStatusParty('nsdap', "NSDAP", Q.nsdap_seats)}

Q.parliament_diagram = data_st

if (d3 && window && Q.started) {
    // get screen width
    var data = Q.parliament_diagram
    var width = 500;
    var height = 500;
    /*
    var screenWidth = document.getElementById('qualities').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichstag_st").style.height = screenWidth/2 + "px"; 
    }*/
    var reichstag_st = d3.parliament();
    reichstag_st.width(width).height(height).innerRadiusCoef(0.4);
    reichstag_st.enter.fromCenter(false).smallToBig(false);
    reichstag_st.exit.toCenter(false).bigToSmall(false);

    var svg = d3.select("#reichstag_st")
        .datum(data)
        .call(reichstag_st);

    var bbox = svg.node().getBBox();
    var padding = 10; // small buffer so seat edges aren't clipped

    svg
        .attr("viewBox",
            `${bbox.x - padding} ${bbox.y - padding} ${bbox.width + padding * 2} ${bbox.height + padding * 2}`
        )
        .attr("preserveAspectRatio", "xMidYMid meet")
        .attr("width", null)
        .attr("height", null)
        .style("width", "100%")
        .style("max-width", "500px")
        .style("height", "auto")
        .style("display", "block");
}
!}

<h1>Reichstag</h1>
<hr>

[? if president_reichstag == "Johannes Kaempf" : <div><img src="img/portraits/Johannes_Kaempf.jpg" alt="Johannes Kaempf" style="width: 50%;display: block;margin: auto;margin-top: 5px;margin-bottom: 5px;border: 5px solid var(--card-border-color);"></div> ?]
<div style="text-align: center;">**[+ president_reichstag +]** (<span style="color: var(--president_reichstag_color)"><strong>[+ president_reichstag_party +]</strong></span>)</div>
[? if nov_revolution = 0 and interim_government = 0 : <div style="text-align: center; color: var(--unavailable-color); font-size: 0.8em;"><em>President of the Reichstag</em></div> ?]
[? if nov_revolution = 1 and interim_government = 1 : <div style="text-align: center; color: var(--unavailable-color); font-size: 0.8em;"><em>President of the Weimar National Assembly</em></div> ?]

<div style="display: flex; justify-content: center; align-items: center; width: 100%;">{!<svg id="reichstag_st"> </svg>!} </div>
<div style="display: flex; justify-content: center; align-items: center; height: 100%;"><span style="margin-top: -50px;"><strong><h1>[+ total_seats +]</h1></strong></span></div>

{!<table style="margin: 0 auto; table-layout: auto; width: auto;">!}
{!<tr><td>Party</td><td>Seats</td><td>Status</td></tr>!}
[? if kpd_formed = 1 : {!<tr><td><div class="box" style='background-color: var(--kpd_color); outline: 2px; outline-style: solid;'> </div> !} <strong> KPD: </strong> {!</td><td>!} <strong>[+ kpd_seats +]</strong> <strong>([+ kpd_per +]%)</strong> {!</td><td>!} [? if kpd_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if kpd_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

[? if uspd_formed = 1 and kpd_formed = 0: {!<tr><td><div class="box" style='background-color: var(--uspd_color); outline: 2px; outline-style: solid;'> </div> !} <strong>USPD:</strong> {!</td><td>!} <strong>[+ uspd_seats +]</strong> <strong>([+ uspd_per +]%)</strong> {!</td><td>!} [? if uspd_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if uspd_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]
[? if uspd_formed = 1 and kpd_formed = 1: {!<tr><td><div class="box" style='background-color: var(--uspd_color);'> </div> !} USPD: {!</td><td>!} [+ uspd_seats +] ([+ uspd_per +]%) {!</td><td>!} [? if uspd_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if uspd_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

[? if uspd_formed = 0 : {!<tr><td><div class="box" style='background-color: var(--spd_color); outline: 2px; outline-style: solid;'> </div> !} <strong>SPD:</strong> {!</td><td>!} <strong>[+ spd_seats +]</strong> <strong>([+ spd_per +]%)</strong> {!</td><td>!} [? if spd_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if spd_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]
[? if uspd_formed = 1 : {!<tr><td><div class="box" style='background-color: var(--spd_color);'> </div> !} MSPD: {!</td><td>!} [+ spd_seats +] ([+ spd_per +]%) {!</td><td>!} [? if spd_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if spd_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color: var(--other_color);'> </div> !} Others: {!</td><td>!} [+ other_seats +] ([+ other_r +]%) {!</td><td>!} [? if other_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if other_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

[? if pp_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #D49797;'> </div> !} <span class="tooltip-text" data-tooltip="Polish Parties">PP</span>: {!</td><td>!} [+ pp_seats +] (4.5%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if dhp_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #333FFF;'> </div> !} <span class="tooltip-text" data-tooltip="German-Hanoverian Party">DHP</span>: {!</td><td>!} [+ dhp_seats +] (1.3%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if elp_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #000;'> </div> !} <span class="tooltip-text" data-tooltip="Alsace-Lorraine Party">ELP</span>: {!</td><td>!} [+ elp_seats +] (2.3%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if bb_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #008B45;'> </div> !} <span class="tooltip-text" data-tooltip="Bavarian Peasants' League">BB</span>: {!</td><td>!} [+ bb_seats +] (1.8%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if nov_revolution = 0 : {!<tr><td><div class="box" style='background-color: var(--ddp_color);'> </div> !} FVp: {!</td><td>!} [+ ddp_seats +] ([+ ddp_per +]%) {!</td><td>!} [? if ddp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if ddp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]
[? if nov_revolution = 1 : {!<tr><td><div class="box" style='background-color: var(--ddp_color);'> </div> !} DDP: {!</td><td>!} [+ ddp_seats +] ([+ ddp_per +]%) {!</td><td>!} [? if ddp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if ddp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color: var(--z_color);'> </div> !} Z: {!</td><td>!} [+ z_seats +] ([+ z_per +]%) {!</td><td>!} [? if z_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if z_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

[? if nov_revolution = 1 : {!<tr><td><div class="box" style='background-color: var(--bvp_color);'> </div> !} BVP: {!</td><td>!} [+ bvp_seats +] ([+ bvp_per +]%) {!</td><td>!} [? if bvp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if bvp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

[? if nov_revolution = 0 : {!<tr><td><div class="box" style='background-color: var(--dvp_color);'> </div> !} NLP: {!</td><td>!} [+ dvp_seats +] ([+ dvp_per +]%) {!</td><td>!} [? if dvp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if dvp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]
[? if nov_revolution = 1 : {!<tr><td><div class="box" style='background-color: var(--dvp_color);'> </div> !} DVP: {!</td><td>!} [+ dvp_seats +] ([+ dvp_per +]%) {!</td><td>!} [? if dvp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if dvp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

[? if drp_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #00C0ff;'> </div> !} <span class="tooltip-text" data-tooltip="German Reich Party">DRP</span>: {!</td><td>!} [+ drp_seats +] (3.5%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if nov_revolution = 0 : {!<tr><td><div class="box" style='background-color: var(--dnvp_color);'> </div> !} DKP: {!</td><td>!} [+ dnvp_seats +] ([+ dnvp_per +]%) {!</td><td>!} [? if dnvp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if dnvp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]
[? if nov_revolution = 1 : {!<tr><td><div class="box" style='background-color: var(--dnvp_color);'> </div> !} DNVP: {!</td><td>!} [+ dnvp_seats +] ([+ dnvp_per +]%) {!</td><td>!} [? if dnvp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if dnvp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

[? if ansem_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #8B5A2B;'> </div> !} <span class="tooltip-text" data-tooltip="German Völkisch Party">DvP</span>: {!</td><td>!} [+ ansem_seats +] (2.5%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if nsdap_formed = 1 : {!<tr><td><div class="box" style='background-color: var(--nsdap_color);'> </div> !} NSDAP: {!</td><td>!} [+ nsdap_seats +] ([+ nsdap_per +]%) {!</td><td>!} [? if nsdap_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if nsdap_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]
{!</table>!}

[? if spd_in_government = 1 : Budget: [+ budget +] ?]

<div style="text-align: center;"><span>Next election: [+ next_election_month : month +] [+ next_election_year +]</span></div>

@map

[? if nov_revolution = 0 : <h1>Map of the <span style="color: #000"><strong>German Empire</strong></h1>?]

[? if great_war_over = 0: <div style="display: flex; justify-content: center; align-items: center;"> <img src="img/German_Empire_states_map.svg" alt="Map of the German Empire"></div>?]

<div> 
<div style="text-align: center;">
[? if real_started = 1 : <h1><a href="#" onclick="window.dendryUI.dendryEngine.goToScene('regions'); return false;" style="display: inline-block; padding: 4px 10px; border: 1px solid #431; color: #431; font-size: 1em; cursor: pointer; font-family: Georgia, serif; text-transform: uppercase; letter-spacing: 0.05em;">Regions</a></h1> ?]
</div>
</div>