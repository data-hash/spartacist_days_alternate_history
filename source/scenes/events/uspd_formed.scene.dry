on-arrival: {!
// set up the infrastructure
Q.uspd_formed = 1;
Q.parties.push('uspd');

Q.workers_uspd = 10;
Q.workers_spd -= 3;
Q.new_middle_uspd = 1;
Q.old_middle_uspd = 0;
Q.rural_uspd = 0;
Q.unemployed_uspd = 2;
Q.catholics_uspd = 0;

Q.workers_other -= 5;

if (Q.unions_independent) {
    Q.workers_sapd += 8;
}

// update all records
Q.uspd_r = 0;
Q.old_uspd_r = 0;
for (var record of Q.election_records) {
    record['sapd'] = 0;
}
for (var record of Q.party_support_records) {
    record['sapd'] = 0;
}

const spd_seat = document.styleSheets[0].rules[97].style;
const uspd_seat = document.styleSheets[0].rules[106].style;

spd_seat.removeProperty("stroke");
spd_seat.removeProperty("stroke-width");

uspd_seat.setProperty("stroke", "var(--border-color)")
uspd_seat.setProperty("stroke-width", "1.5px")

!}
