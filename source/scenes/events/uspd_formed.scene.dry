on-arrival: {!
// set up the infrastructure
Q.uspd_formed = 1;
Q.parties.push('uspd');

Q.workers_uspd = 10;
Q.workers_spd -= 3;
Q.new_middle_uspd = 1;
Q.old_middle_uspd = 0;
Q.rural_uspd = 0;
Q.unemployed_uspd = 30;
Q.unemployed_spd -= 10;
Q.catholics_uspd = 0;

Q.spd_relation = 35;
Q.ddp_relation = 30;
Q.z_relation = 25;
Q.dvp_relation = 13;
Q.dnvp_relation = 6;

Q.spd_leader = "Friedrich Ebert";

Q.workers_other -= 5;

if (Q.unions_independent) {
    Q.workers_sapd += 8;
}

// update all records
Q.uspd_r = 3.77;
Q.spd_r = 23.93;
Q.old_uspd_r = 0;
for (var record of Q.election_records) {
    record['sapd'] = 0;
}
for (var record of Q.party_support_records) {
    record['sapd'] = 0;
}

const sheet = document.styleSheets[0]; // or find it by href, see below

for (const rule of sheet.cssRules) {
  if (rule.selectorText === '.seat.spd') { // match the exact selector
    rule.style.removeProperty('stroke');
    rule.style.removeProperty('stroke-width');
    break; // stop once found
  }
}

for (const rule of sheet.cssRules) {
  if (rule.selectorText === '.seat.uspd') { // match the exact selector
    rule.style.setProperty('stroke', 'var(--border-color)');
    rule.style.setProperty('stroke-width', '1.5px');
    break; // stop once found
  }
}

!}
