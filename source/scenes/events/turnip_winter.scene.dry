title: Turnip Winter
subtitle: Famine ravages most of Germany.
tags: event
view-if: nov_revolution = 0 and turnip_winter_timer = 0
max-visits: 1
on-arrival: {!
	Q.pro_empire -= 5
	Q.unemployed += 1
!}

