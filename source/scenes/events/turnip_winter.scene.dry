subtitle: -1 resources
choose-if: resources >= 1
unavailable-subtitle: Not enough resources.
on-arrival: {!
	Q.resources -= 1
	Q.grassroots_support += 5

	Q.unemployed_spd += 5*(1-Q.dissent)
	Q.workers_spd += 3*(1-Q.dissent)
	Q.catholics_spd += 2(1-Q.dissent)
!}

