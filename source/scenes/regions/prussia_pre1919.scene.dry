title: Prussia
subtitle: Kingdom of Prussia
view-if: nov_revolution = 0
new-page: true
tags: regions
on-arrival: {!

const spd_pr_seats = Math.round(2.25*Q.prussa_seats)
Q.spd_pr_seats = spd_pr_seats
let spdPrPer = (Q.spd_pr_seats / (Q.prussa_seats * 100)) * 100
Q.spdPrPer = spdPrPer.toFixed()

const pp_pr_seats = Math.round(2.7*Q.prussa_seats)
Q.pp_pr_seats = pp_pr_seats
let ppPrPer = (Q.pp_pr_seats / (Q.prussa_seats * 100)) * 100
Q.ppPrPer = ppPrPer.toFixed()

const dp_pr_seats = Math.round(0.45*Q.prussa_seats)
Q.dp_pr_seats = dp_pr_seats
let dpPrPer = (Q.dp_pr_seats / (Q.prussa_seats * 100)) * 100
Q.dpPrPer = dpPrPer.toFixed()

const ddp_pr_seats = Math.round(9.25*Q.prussa_seats)
Q.ddp_pr_seats = ddp_pr_seats
let ddpPrPer = (Q.ddp_pr_seats / (Q.prussa_seats * 100)) * 100
Q.ddpPrPer = ddpPrPer.toFixed()

const z_pr_seats = Math.round(23.25*Q.prussa_seats)
Q.z_pr_seats = z_pr_seats
let zPrPer = (Q.z_pr_seats / (Q.prussa_seats * 100)) * 100
Q.zPrPer = zPrPer.toFixed()

const dvp_pr_seats = Math.round(16.47*Q.prussa_seats)
Q.dvp_pr_seats = dvp_pr_seats
let dvpPrPer = (Q.dvp_pr_seats / (Q.prussa_seats * 100)) * 100
Q.dvpPrPer = dvpPrPer.toFixed()

const drp_pr_seats = Math.round(12*Q.prussa_seats)
Q.drp_pr_seats = drp_pr_seats
let drpPrPer = (Q.drp_pr_seats / (Q.prussa_seats * 100)) * 100
Q.drpPrPer = drpPrPer.toFixed()

const dnvp_pr_seats = Math.round(33.63*Q.prussa_seats)
Q.dnvp_pr_seats = dnvp_pr_seats
let dnvpPrPer = (Q.dnvp_pr_seats / (Q.prussa_seats * 100)) * 100
Q.dnvpPrPer = dnvpPrPer.toFixed()

Q.total_pr_seats = Q.spd_pr_seats + Q.pp_pr_seats + Q.dp_pr_seats + Q.ddp_pr_seats + Q.z_pr_seats + Q.dvp_pr_seats + Q.drp_pr_seats + Q.dnvp_pr_seats

!}
on-display: {!
/* TODO: potentially move to a js script for ease of access and cleaner code */
const data_pr = []

if (Q.spd_r) {
    data_pr.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round(2.25*Q.prussa_seats),
    })
}

if (Q.pp_dissolved == 0) {
    data_pr.push({
        "id": "pp",
        "legend": "PP",
        "name": "PP",
        "seats": Math.round(2.7*Q.prussa_seats),
    })
}

if (Q.bb_dissolved == 0) {
    data_pr.push({
        "id": "bb",
        "legend": "DP",
        "name": "DP",
        "seats": Math.round(0.45*Q.prussa_seats),
    })
}

if (Q.ddp_r) {
    data_pr.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(9.25*Q.prussa_seats),
    })
}

if (Q.z_r) {
    data_pr.push({
        "id": "z",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(23.25*Q.prussa_seats),
    })
}

if (Q.dvp_r) {
    data_pr.push({
        "id": "dvp",
        "legend": Q.dvp_name,
        "name": Q.dvp_name,
        "seats": Math.round(16.47*Q.prussa_seats),
    })
}

if (Q.drp_dissolved == 0) {
    data_pr.push({
        "id": "drp",
        "legend": "DRP",
        "name": "DRP",
        "seats": Math.round(12*Q.prussa_seats),
    })
}

if (Q.dnvp_r) {
    data_pr.push({
        "id": "dnvp",
        "legend": Q.dnvp_name,
        "name": Q.dnvp_name,
        "seats": Math.round(33.63*Q.prussa_seats),
    })
}

Q.prussia_parliament_diagram = data_pr

if (d3 && window && Q.started) {
    // get screen width
    var data = Q.prussia_parliament_diagram
    var width = 500;
    var height = 500;
    /*
    var screenWidth = document.getElementById('qualities').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichstag_st").style.height = screenWidth/2 + "px"; 
    }*/
    var landtag_pr = d3.parliament();
    landtag_pr.width(width).height(height).innerRadiusCoef(0.4);
    landtag_pr.enter.fromCenter(false).smallToBig(false);
    landtag_pr.exit.toCenter(false).bigToSmall(false);

    var svg = d3.select("#landtag_pr")
        .datum(data)
        .call(landtag_pr);

    var bbox = svg.node().getBBox();
    var padding = 10; // small buffer so seat edges aren't clipped

    svg
        .attr("viewBox",
            `${bbox.x - padding} ${bbox.y - padding} ${bbox.width + padding * 2} ${bbox.height + padding * 2}`
        )
        .attr("preserveAspectRatio", "xMidYMid meet")
        .attr("width", null)
        .attr("height", null)
        .style("width", "100%")
        .style("max-width", "500px")
        .style("height", "auto")
        .style("display", "block");
}
!}

<h1>Prussian House of Representatives</h1>
<hr>

<div style="display: flex; justify-content: center; align-items: center; width: 100%;">{!<svg id="landtag_pr"> </svg>!} </div>
<div style="display: flex; justify-content: center; align-items: center; height: 100%;"><span style="margin-top: -50px;"><strong><h1>443</h1></strong></span></div>

{!<table style="margin: 0 auto; table-layout: auto; width: auto;">!}
{!<tr><td>Party</td><td>Seats</td><td>Status</td></tr>!}

[? if uspd_formed = 0 : {!<tr><td><div class="box" style='background-color: var(--spd_color); outline: 2px; outline-style: solid;'> </div> !} <strong><span class="tooltip-text" data-tooltip="Social Democratic Party">SPD</span>:</strong> {!</td><td>!} <strong>[+ spd_pr_seats +]</strong> <strong>([+ spd_per +]%)</strong> {!</td><td>!} [? if spd_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if spd_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]
[? if uspd_formed = 1 : {!<tr><td><div class="box" style='background-color: var(--spd_color);'> </div> !} <span class="tooltip-text" data-tooltip="Majority Social Democratic Party">MSPD</span>: {!</td><td>!} [+ spd_pr_seats +] ([+ spdPrPer +]%) {!</td><td>!} [? if spd_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if spd_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

[? if pp_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #D49797;'> </div> !} <span class="tooltip-text" data-tooltip="Polish Party">PP</span>: {!</td><td>!} [+ pp_pr_seats +] ([+ ppPrPer +]%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if pp_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #008B45;'> </div> !} <span class="tooltip-text" data-tooltip="Danish Party">DP</span>: {!</td><td>!} [+ dp_pr_seats +] ([+ dpPrPer +]%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if nov_revolution = 0 : {!<tr><td><div class="box" style='background-color: var(--ddp_color);'> </div> !} <span class="tooltip-text" data-tooltip="Progressive People's Party">FVp</span>: {!</td><td>!} [+ ddp_pr_seats +] ([+ ddpPrPer +]%) {!</td><td>!} [? if ddp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if ddp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color: var(--z_color);'> </div> !} <span class="tooltip-text" data-tooltip="Centre Party">Z</span>: {!</td><td>!} [+ z_pr_seats +] ([+ zPrPer +]%) {!</td><td>!} [? if z_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if z_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!}

[? if nov_revolution = 0 : {!<tr><td><div class="box" style='background-color: var(--dvp_color);'> </div> !} <span class="tooltip-text" data-tooltip="National Liberal Party">NLP</span>: {!</td><td>!} [+ dvp_pr_seats +] ([+ dvpPrPer +]%) {!</td><td>!} [? if dvp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if dvp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

[? if drp_dissolved = 0 : {!<tr><td><div class="box" style='background-color: #00C0ff;'> </div> !} <span class="tooltip-text" data-tooltip="German Reich Party">DRP</span>: {!</td><td>!} [+ drp_pr_seats +] ([+ drpPrPer +]%) {!</td><td>!} <span style="color: #CC0000;">Opp.</span> {!</td></tr>!} ?]

[? if nov_revolution = 0 : {!<tr><td><div class="box" style='background-color: var(--dnvp_color);'> </div> !} <span class="tooltip-text" data-tooltip="German Conservative Party">DKP</span>: {!</td><td>!} [+ dnvp_pr_seats +] ([+ dnvpPrPer +]%) {!</td><td>!} [? if dnvp_in_government = 0: <span style="color: #CC0000;">Opp.</span>?][? if dnvp_in_government = 1: <span style="color: #009900;">Gov.</span>?] {!</td></tr>!} ?]

- @return: Back

@return
go-to: regions